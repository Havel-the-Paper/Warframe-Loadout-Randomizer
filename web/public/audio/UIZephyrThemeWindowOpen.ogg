<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="description" content="Warframe Sound Archive archives all Warframe sound files and makes them available for download.">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Warframe Sound Archive</title>
<script>
const processedFilesHTML = new Set();
let openPlayers = [];

let searchStructAllVersions = [], searchStructCurrentVersion = [];
let showAllInSearch = false;

/*function showAllSearchResults() {
    showAllInSearch = true;
    performSearch(document.getElementById("searchtext2").value);
}*/

function padIntZeroes(i) {
    return i.toString().padStart(2, "0");
}

function timestampToDateString(timestamp) {
    const date = new Date(timestamp * 1000); // timestamp is in seconds
    return `${date.getFullYear()}-${padIntZeroes(date.getMonth() + 1)}-${padIntZeroes(date.getDate())} ${padIntZeroes(date.getHours())}:${padIntZeroes(date.getMinutes())}:${padIntZeroes(date.getSeconds())}`;
}

function makeSequenceTagSearchable(text) {
    return text.toLowerCase().replaceAll("\n", " ").replaceAll(/[.,?!"';]/g, "").replaceAll(/\s/g, "");
}

function parseSearchStructure(structText) {
    console.log(structText.length);
    
    searchStructAllVersions = [];
    searchStructCurrentVersion = [];
    
    for (let i = 0; i < structText.length; /**/) {
        const isInCurrentManifest = structText[i] == '1';
        const hash = structText.substring(i + 1, i + 33);
        const endOfFileNameIdx = structText.indexOf("|", i + 33);
        if (endOfFileNameIdx === -1) {
            console.error("bailing out of loop due to missing sequence tag separator");
            return;
        }
        
        const fileName = structText.substring(i + 33, structText.indexOf("|", endOfFileNameIdx));
        let sequenceTag = "";
        
        i = endOfFileNameIdx + 1;
        while (i < structText.length && structText[i] != '\r' && structText[i] != '\n') {
            sequenceTag += structText[i++];
        }
        
        while (i < structText.length && (structText[i] == '\r' || structText[i] == '\n'))
            ++i;
        
        sequenceTag = sequenceTag.replaceAll("\\r", "").replaceAll("\\n", "\n");
        const obj = { hash: hash, name: fileName, nameSearchable: fileName.toLowerCase(), sequence: sequenceTag, sequenceSearchable: makeSequenceTagSearchable(sequenceTag) };
        searchStructAllVersions.push(obj);
        
        if (isInCurrentManifest)
            searchStructCurrentVersion.push(obj);
    }
    
    console.log("done!");
    performSearch(document.getElementById("searchtext2").value);
}

async function openSearch() {
    const dialog = document.getElementById("searchdialog");
    document.getElementById("searchtext2").value = "";
    dialog.showModal();
    
    const response = await fetch("/api/searchdb?version=latest");
    if (response.ok) {
        parseSearchStructure(await response.text());
    }
}

function setFileNameSearchResults(results, showingAll) {
    document.getElementById("searchresulttf").textContent = `${results.length}${showingAll || results.length < 1000 ? "" : " (showing first 1000)"}`;
    //document.getElementById("searchlinkf").style.display = showingAll || results.length < 1000 ? "none" : "";
    
    const filteredFiles = document.createElement("div");
    filteredFiles.id = "searchresultsfiles2";
    
    for (const result of results) {
        const fileEntry = document.createElement("div");
        fileEntry.id = `s_${result.hash}`;
        fileEntry.classList.add("k");
        fileEntry.textContent = result.name;
        appendFileLinks(fileEntry, result.hash);
        
        filteredFiles.appendChild(fileEntry);
    }
    
    document.getElementById("searchresultsfiles2").replaceWith(filteredFiles);
}

function setSequenceTagSearchResults(results, showingAll) {
    document.getElementById("searchresultts").textContent = `${results.length}${showingAll || results.length < 1000 ? "" : " (showing first 1000)"}`;
    //document.getElementById("searchlinks").style.display = showingAll || results.length < 1000 ? "none" : "";
    
    const filteredFiles = document.createElement("div");
    filteredFiles.id = "searchresultsseqtags2";
    
    for (const result of results) {
        const fileEntry = document.createElement("div");
        fileEntry.id = `s_${result.hash}`;
        fileEntry.classList.add("k");
        fileEntry.textContent = result.name;
        appendFileLinks(fileEntry, result.hash);
        
        const seqTag = document.createElement("div");
        seqTag.textContent = result.sequence;
        seqTag.classList.add("st");
        
        const entryWithSeqTag = document.createElement("div");
        entryWithSeqTag.appendChild(seqTag);
        entryWithSeqTag.appendChild(fileEntry);
        entryWithSeqTag.style.borderBottom = "1px solid #ccc";
        entryWithSeqTag.style.marginBottom = "8px";
        
        filteredFiles.appendChild(entryWithSeqTag);
    }
    
    document.getElementById("searchresultsseqtags2").replaceWith(filteredFiles);
}

function performSearch(text) {
    const db = document.getElementById("searchall").checked ? searchStructAllVersions : searchStructCurrentVersion;
    
    const queryFileName = text.toLowerCase().replaceAll(/\s/g, "");
    const querySeqTag = makeSequenceTagSearchable(text);
    
    const resultsFiles = [];
    const resultsSequenceTags = [];
    
    for (let i = 0; i < db.length; ++i) {
        if ((showAllInSearch || resultsFiles.length < 1000) && db[i].nameSearchable.includes(queryFileName)) {
            resultsFiles.push(db[i]);
        }
        if ((showAllInSearch || resultsSequenceTags.length < 1000) && db[i].sequence.length > 0 && db[i].sequenceSearchable.includes(querySeqTag)) {
            resultsSequenceTags.push(db[i]);
        }
        
        // early exit from loop
        if (!showAllInSearch && resultsFiles.length >= 1000 && resultsSequenceTags.length >= 1000) {
            break;
        }
    }
    
    setFileNameSearchResults(resultsFiles, showAllInSearch);
    setSequenceTagSearchResults(resultsSequenceTags, showAllInSearch);
}

function onPlay(e) {
    let fileId = e.parentElement.id;
    const isSearchResult = fileId.startsWith("s_"); // part of search results
    
    if (isSearchResult)
        fileId = fileId.substring(2);
    
    if (e.innerHTML.includes("play")) {
        openPlayers.forEach(t => t.pause());
        
        const audioElement = document.createElement("audio");
        audioElement.autoplay = true;
        audioElement.controls = true;
        audioElement.src = `/api/download?id=${fileId}&format=mp3`;

        e.innerHTML = e.innerHTML.replace("play", "close");

        const detailsElement = document.getElementById(`${isSearchResult ? "s_" : ""}${fileId}_details`);
        if (detailsElement) {
            e.parentElement.insertBefore(audioElement, detailsElement);
        } else {
            e.parentElement.appendChild(audioElement);
        }
        
        openPlayers.push(audioElement);
    } else {
        let audioElement;
        for (const childElement of e.parentElement.children) {
            if (childElement.tagName.toLowerCase() === "audio") {
                audioElement = childElement;
                break;
            }
        }
        
        if (audioElement != null) {
            audioElement.pause();
            audioElement.remove();

            const idx = openPlayers.indexOf(audioElement);
            if (idx > -1) {
                openPlayers.splice(idx, 1);
            }
        }

        e.innerHTML = e.innerHTML.replace("close", "play");
    }
    
    console.log(openPlayers);
}

async function onShow(e) {
    let fileId = e.parentElement.id;
    const isSearchResult = fileId.startsWith("s_"); // part of search results
    
    if (fileId.startsWith("s_")) // part of search results
        fileId = fileId.substring(2);

    let detailsElement = document.getElementById(`${isSearchResult ? "s_" : ""}${fileId}_details`);
    if (detailsElement != null) {
        if (detailsElement.style.display == "none") {
            detailsElement.style.display = "";
            e.innerText = "[hide details]";
        } else {
            detailsElement.style.display = "none";
            e.innerText = "[show details]";
        }
        
        return;
    }
    
    detailsElement = document.createElement("div");
    detailsElement.id = `${isSearchResult ? "s_" : ""}${fileId}_details`;
    detailsElement.innerHTML = "&nbsp;&#9500;&#9472; Loading...";
    
    e.parentElement.appendChild(detailsElement);
    e.innerText = "[hide details]";
    
    const response = await fetch(`/api/metadata?id=${fileId}`);
    if (!response.ok) {
        detailsElement.innerHTML = `<span style="color: #e44">&nbsp;&#9500;&#9472; Failed to fetch file metadata:<br><span style="white-space: pre">&nbsp;&#9492;&#9472; [HTTP ${response.status}] ${await response.text()}</span></span>`;
    } else {
        const fileInfo = await response.json();
        
        const dspElement = fileInfo.metadata.dsp ? `<a href="/api/dsp?manifest=${fileInfo.metadata.version}&name=${fileInfo.metadata.dsp}" target="_blank">${fileInfo.metadata.dsp}</a>` : '<span style="color: #999">(none)</span>';
        const addedElement = `<span style="color: #9f9">${fileInfo.added}${fileInfo.addedunk ? " or earlier" : ""}</span>`;
        const modifiedElement = fileInfo.modified > 0 ? `; modified <a href="/singlefile?file=${fileInfo.metadata.filename}" target="_blank" style="color: #9ff">${fileInfo.modified} time${fileInfo.modified > 1 ? 's' : ''}</a>` : "";
        const removedElement = fileInfo.removed ? `; removed in <span style="color: #f99">${fileInfo.removed}</span>` : "";
        
        detailsElement.innerHTML = `&nbsp;&#9500;${"&#9472;".repeat(25)} ${fileInfo.metadata.filename} ${"&#9472;".repeat(25)}<br>`;
        detailsElement.innerHTML += `&nbsp;&#9500;&#9472;&#9472; Extraction date: ${timestampToDateString(fileInfo.metadata.timestamp)} (${fileInfo.metadata.version}) <span style="text-decoration: underline dotted; color: #999" title="This date marks the file's addition to the Archive.&#010;It is not related to the file's presence in game files.&#010;&#010;Date format: YYYY-MM-DD, in your local time zone">(?)</span><br>`;
        detailsElement.innerHTML += `&nbsp;&#9500;&#9472;&#9472; In-game DSP effects: ${dspElement}<br>`;
        detailsElement.innerHTML += `&nbsp;&#9500;&#9472;&#9472; File introduced in ${addedElement}${modifiedElement}${removedElement}.<br>`;
        detailsElement.innerHTML += `&nbsp;&#9492;&#9472;&#9472; Subtitle text: ${fileInfo.metadata.sequence ? '<span class="st">' + fileInfo.metadata.sequence + '</span>' : '<span style="color: #999">(no subtitle text found)</span>'}`;
    }
}

function appendFileLinks(obj, fileId) {
    obj.innerHTML += ` <a class="l" href="/api/download?id=${fileId}&format=ogg">[ogg]</a> ` + 
        `<a class="l" href="/api/download?id=${fileId}&format=wav">[wav]</a> ` +
        `<span class="p" onclick="onPlay(this)">[play]</span> ` +
        `<span class="s" onclick="onShow(this)">[show details]</span>`;
}

function addSingleFileLinksLazy(file) {
    const fileId = file.id;
    if (processedFilesHTML.has(fileId))
        return;
    
    appendFileLinks(file, fileId);
    processedFilesHTML.add(fileId);
}

function addFileLinksLazy(dir) {
    for (const element of dir.parentElement.children)
        if (element.classList.contains("k"))
            addSingleFileLinksLazy(element);
}

function dirClickHandler(e) {
    if (e.currentTarget.parentElement.classList.toggle("g"))
        addFileLinksLazy(e.currentTarget);
}

function postParseDocument() {
    for (const dir of document.getElementsByClassName("f")) {
        dir.onclick = dirClickHandler;
        if (dir.parentElement.classList.contains("g"))
            addFileLinksLazy(dir);
    }
    
    document.getElementById("searchbutton").addEventListener("click", openSearch);
    document.getElementById("searchtext2").addEventListener("input", (e) => {
        performSearch(e.target.value);
    });
    
    document.getElementById("searchdialog").addEventListener("click", (e) => {
        const dialog = document.getElementById("searchdialog");
        if (e.target !== dialog)
            return;
        
        const r = dialog.getBoundingClientRect();
        const isInDialog = r.top <= e.clientY && e.clientY <= r.top + r.height && r.left <= e.clientX && e.clientX <= r.left + r.width;
        if (!isInDialog)
            dialog.close();
    });
    
    document.getElementById("searchdialog").addEventListener("close", (e) => {
        showAllInSearch = false;
        setFileNameSearchResults([]);
        setSequenceTagSearchResults([]);
    });
    
    setFileNameSearchResults([]);
    setSequenceTagSearchResults([]);
}

if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", postParseDocument);
else
    postParseDocument();
</script>
<style>
* { box-sizing: border-box; }
body { margin: 0; background-color: #121417; font-family: Lucida Grande,Lucida Sans Unicode,Lucida Sans,Geneva,Verdana,sans-serif; font-size: 14px; color: #fff; }
audio { vertical-align: middle; }
a:link, a:visited, a:hover, a:active { color: #0df; }

.topnav { display: flex; justify-content: center; align-items: center; padding: 10px 2%; background-color: #111a33; overflow: hidden; border-bottom: 1px solid #444; }
.topnav > :first-child { flex: 1; justify-content: flex-start; }
.topnav > :last-child { flex: 1; display: flex; justify-content: flex-end; }
.topnavsearch { width: 30em; height: 30px; background-color: #111a33; font-family: Lucida Grande,Lucida Sans Unicode,Lucida Sans,Geneva,Verdana,sans-serif; font-size: 14px; color: #fff; }

.topnavlogo { font-size: 20px; }
.topnavlink { font-size: 14px; padding-left: 15px; }

.topnavdropdown::after {
	display: inline-block;
	margin-left: .255em;
	vertical-align: .255em;
	content: "";
	border-top: .3em solid;
	border-right: .3em solid transparent;
	border-bottom: 0;
	border-left: .3em solid transparent;
}

.maincontent { padding: 0 10%; }
.filetree { font-family: monospace, monospace; padding-bottom: 12px; }

.f { cursor: pointer; color: #0ff; }
.f::before { color: #fff; content: "[+] "; }
.g > .f::before { content: "[-] " !important; }

.e > div { padding-left: 32px; }
.e:not(.g) > div { display: none; }

.k { color: #fff; }
.k::before { color: #fff; content: "[*] "; }

.l { text-decoration: none; cursor: pointer; color: #0f0 !important; }
.p { cursor: pointer; color: #309fff; }
.s { cursor: pointer; color: #cc00cc; }

.x::before { color: #0f0; content: "[+] "; }
.y::before { color: #0ff; content: "[*] "; }
.z::before { color: #f00; content: "[-] "; }

/* Sequence tags (aka dialog subtitles) */
.st { color: #ccf; white-space: pre-wrap; }

.histver { color: #ff0; }

#searchresults { display: flex; flex-direction: column; height: calc(100% - 100px); box-sizing: border-box; }
#searchresultsfiles { flex: 0 auto; max-height: 50%; overflow: hidden; overflow-y: auto; padding-bottom: 8px; margin-bottom: 8px; border-bottom: 1px solid #aaa; }
#searchresultsseqtags { flex: 1; overflow: hidden; overflow-y: auto; }

#searchresultsfiles2 { font-family: monospace, monospace; }
#searchresultsseqtags2 { font-family: monospace, monospace; }

#searchdialog {
    width: 65%;
    height: 76vh;
    background-color: #160709;
    margin-top: 12vh;
    padding: 8px;
    border: 1px solid #500;
    border-radius: 4px;
    color: #fff;
}

#searchdialog::backdrop {
    background-color: #120a07;
    opacity: 0.75;
}

#searchtext {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 8px;
    margin-bottom: 4px;
    box-sizing: border-box;
    background-color: #2a0713;
    border: 1px solid #a00;
    border-radius: 8px;
}

#searchglass {
    stroke-width: 2;
    height: 20px;
    width: 20px;
    color: #f00;
}

#searchtext2 {
    background: transparent;
    border: 0px;
    height: 100%;
    width: 80%;
    padding: 0 0 0 10px;
    font: inherit;
    font-size: 16px;
    color: #eee;
    outline: none;
}

.noline { text-decoration: none; }
.noline:link, .noline:visited, .noline:active { color: #fff; }
.noline:hover { color: #bbb; }

.nolinesf { text-decoration: none; }
.nolinesf:link, .nolinesf:visited, .nolinesf:active { color: #C57777; }
.nolinesf:hover { color: #C54747; }

.nolinediscord { text-decoration: none; }
.nolinediscord:link, .nolinediscord:visited, .nolinediscord:active { color: #AEB2F6; }
.nolinediscord:hover { color: #6E83C5; }
</style>
</head>
<body>

<div class="topnav">
<div><a class="topnavlogo noline" href="/">Warframe Sound Archive</a><div style="display: inline; padding-left: 20px"></div><a class="topnavlink noline" href="/">Home</a><a class="topnavlink noline" href="/faq">FAQ</a><a class="topnavlink nolinesf" href="https://sf.kasumata.ee/" target="_blank">Soulframe</a><a class="topnavlink nolinediscord" href="https://discord.gg/cXCZzZJnDE" target="_blank">Discord</a></div>
<div><button id="searchbutton" class="topnavsearch">Search (dialog text, file name, etc...)</button></div>
<div><a class="topnavlink topnavdropdown noline" href="#">Latest version (43.5.1)</a><a class="topnavlink noline" href="#">Changelogs</a></div>
</div>

<div class="maincontent">
<p style="text-align: center"><span style="font-weight: bold">This website provides a complete index of Warframe sound files.</span><br>
<span style="color: #e55; font-weight: bold">Warning! Spoilers ahead.</span> You will encounter dialog lines from quests or characters you might not have met yet. You have been warned.<br>
<span style="font-size: 12px">This website is neither affiliated with nor endorsed by Digital Extremes. All files available below are property of their respective owners. Made by Taikelenn.</span></p>
<hr>
